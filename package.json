{
	"name": "visual-second-brain",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@12.4.1",
	"scripts": {
		"dev": "pnpm --filter frontend dev",
		"build": "pnpm --filter frontend build",
		"dev:web": "pnpm --filter frontend dev:web",
		"build:web": "pnpm --filter frontend build:web",
		"dev:site": "pnpm --filter site dev",
		"build:pages": "pnpm --filter site build && pnpm --filter frontend build:web",
		"preview": "pnpm --filter frontend preview",
		"check": "pnpm --filter frontend check && pnpm --filter site check",
		"check:watch": "pnpm --filter frontend check:watch",
		"test": "pnpm --filter frontend test",
		"tauri": "tauri"
	},
	"devDependencies": {
		"@tauri-apps/cli": "^2.12.4"
	}
}
